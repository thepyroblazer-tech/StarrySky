<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/w_cover"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:contentDescription="Open StarrySky"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_w_disc" />

    <LinearLayout
        android:id="@+id/w_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="StarrySky"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Tap to open"
            android:textColor="#FFB8C2D0"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Previous"
        android:padding="8dp"
        android:src="@drawable/ic_w_prev" />

    <FrameLayout
        android:id="@+id/w_play"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp">

        <ImageView
            android:id="@+id/w_play_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/w_circle" />

        <ImageView
            android:id="@+id/w_play_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Play or pause"
            android:padding="12dp"
            android:src="@drawable/ic_w_play" />
    </FrameLayout>

    <ImageView
        android:id="@+id/w_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Next"
        android:padding="8dp"
        android:src="@drawable/ic_w_next" />
</LinearLayout>
